# GitHub OAuth app: https://github.com/settings/developers  -> New OAuth App
# Homepage URL:            http://localhost:5173   (use your real domain in production)
# Authorization callback:  http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the site (no trailing slash). Used for OAuth redirect + share previews.
APP_URL=http://localhost:5173

# Long random string. Signs sessions and encrypts stored GitHub tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Local file DB by default. For production use Turso (free): libsql://your-db.turso.io
DATABASE_URL=file:./data/gitscoop.db
DATABASE_AUTH_TOKEN=

PORT=8787
